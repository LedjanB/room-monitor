{
  "rules": {
    "meta": {
      "initialized": {
        ".read": true,
        ".write": "auth != null && (data.val() !== true || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".validate": "newData.isBoolean()"
      }
    },
    "users": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && ((auth.uid === $uid && !data.exists() && root.child('meta').child('initialized').val() !== true) || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".validate": "newData.hasChildren(['username', 'role'])",
        "username": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60"
        },
        "role": {
          ".validate": "newData.val() === 'admin' || newData.val() === 'user'"
        }
      }
    },
    "state": {
      ".read": "auth != null && root.child('users').child(auth.uid).exists()",
      ".write": "auth != null && root.child('users').child(auth.uid).exists()"
    },
    "notifications": {
      ".read": "auth != null && root.child('users').child(auth.uid).exists()",
      "$noteId": {
        ".write": "auth != null && root.child('users').child(auth.uid).exists()",
        ".validate": "newData.hasChildren(['message', 'ts']) && newData.child('message').isString() && newData.child('message').val().length <= 500 && newData.child('ts').isNumber() && newData.child('ts').val() <= now + 600000"
      }
    }
  }
}
